{
  "name": "ntfy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_OPTIONS=\"--enable-source-maps\" vite",
    "build": "vite build",
    "serve": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --report-unused-disable-directives --ext .js,.jsx ./src/",
